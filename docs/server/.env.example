# Copy to .env and fill in every empty line. Step 5 of docs/server-setup.md shows how to make the secrets.
DOMAIN=ekklesia.web.id

# Cloudflare Tunnel (step 6)
CLOUDFLARE_TUNNEL_TOKEN=

# Secrets
APP_KEY=
JWT_SECRET=
DASHBOARD_DB_PASSWORD=
CHECKIN_DB_PASSWORD=
CHECKIN_JWT_SECRET=
EDGE_KEY=
REG_IP_SALT=
# The password people type to start an email blast in the check-in app. Choose one yourself.
BLAST_PASSWORD=

# Email through Amazon SES (step 2). Both apps use the same sender.
SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SES_SMTP_USER=
SES_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=hello@ekklesia.web.id
MAIL_FROM_NAME=Ekklesia
# Where replies to check-in app emails go. Optional.
MAIL_REPLY_TO=

# Dashboard: name, legal pages and the company line in every page footer. A link left empty is not shown.
VITE_APP_NAME=Ekklesia
VITE_TOS_URL=
VITE_PRIVACY_URL=
VITE_ORGANIZER_TERMS_URL=
VITE_COMMUNITY_GUIDELINES_URL=
VITE_CONTACT_URL=
VITE_COMPANY_INFO=
# Set to true after the first account exists if only invited people may sign up.
APP_DISABLE_REGISTRATION=false

# Check-in app: where the Privacy Policy is hosted. Linked from the registration form and the guardian email.
PRIVACY_POLICY_URL_ID=
PRIVACY_POLICY_URL_EN=
